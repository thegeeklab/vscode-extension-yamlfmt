{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "out",
    "sourceMap": true,

    /* Strict Type-Checking Options */
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,

    /* Project Setup & Build Options */
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"]
  },
  "include": ["src/**/*", "test/**/*", "eslint.config.js"],
  "exclude": ["node_modules", "out", "dist"]
}
